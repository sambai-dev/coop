# Copy this file to .env. Generate a separate high-entropy key per tenant:
#   openssl rand -hex 32
# The value format is tenant:key. Never commit the populated .env file.
ROOKHOLD_API_KEYS=
# Optional, separate operator-only credential for global /metrics.
ROOKHOLD_METRICS_TOKEN=

# The guarded bootstrap fills this with the SHA-256 of the exact private
# rootfs manifest built into the image. An empty value fails gVisor startup.
ROOKHOLD_GVISOR_ROOTFS_SHA256=
ROOKHOLD_GVISOR_PLATFORM=systrap

# Admission, retention, and logging defaults. Tune against measured VM
# capacity; increasing worker count does not create more isolation.
ROOKHOLD_WORKERS=4
ROOKHOLD_TENANT_CONCURRENCY=2
ROOKHOLD_TENANT_QUEUE_CAPACITY=64
ROOKHOLD_RATE_PER_MIN=120
ROOKHOLD_MAX_JOB_MEM_MB=1024
ROOKHOLD_MEMORY_BUDGET_MB=4096
ROOKHOLD_STORAGE_TENANT_MB=4096
ROOKHOLD_STORAGE_GLOBAL_MB=16384
ROOKHOLD_STORAGE_FREE_RESERVE_MB=1024
ROOKHOLD_RETENTION_HOURS=168
ROOKHOLD_SWEEP_INTERVAL_SECS=3600
ROOKHOLD_LOG_FORMAT=json
RUST_LOG=info,coop_server=info
