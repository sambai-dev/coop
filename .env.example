# Copy this file to .env. Generate a separate high-entropy key per tenant:
#   openssl rand -hex 32
# The value format is tenant:key. Never commit the populated .env file.
COOP_API_KEYS=
# Optional, separate operator-only credential for global /metrics.
COOP_METRICS_TOKEN=

# Admission, retention, and logging defaults. Tune against measured VM
# capacity; increasing worker count does not create more isolation.
COOP_WORKERS=4
COOP_TENANT_CONCURRENCY=2
COOP_TENANT_QUEUE_CAPACITY=64
COOP_RATE_PER_MIN=120
COOP_MAX_JOB_MEM_MB=1024
COOP_MEMORY_BUDGET_MB=4096
COOP_STORAGE_TENANT_MB=4096
COOP_STORAGE_GLOBAL_MB=16384
COOP_STORAGE_FREE_RESERVE_MB=1024
COOP_RETENTION_HOURS=168
COOP_SWEEP_INTERVAL_SECS=3600
COOP_LOG_FORMAT=json
RUST_LOG=info,coop_server=info
