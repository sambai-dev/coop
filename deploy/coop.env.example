# Install as /etc/coop/coop.env with mode 0600. Fill COOP_API_KEYS before start.
COOP_ENV=production
COOP_ADDR=127.0.0.1:7300
COOP_API_KEYS=
COOP_SANDBOX=ns
COOP_ROOTFS=/opt/coop/rootfs
COOP_SANDBOX_HELPER=/usr/local/bin/coop-sandbox-init
COOP_JOBS_ROOT=/var/lib/coop/jobs
COOP_DB=/var/lib/coop/coop.db
COOP_SECCOMP=auto
COOP_WORKERS=4
COOP_TENANT_CONCURRENCY=2
COOP_RATE_PER_MIN=120
COOP_RETENTION_HOURS=168
COOP_SWEEP_INTERVAL_SECS=3600
RUST_LOG=info,coop_server=info
