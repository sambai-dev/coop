[Unit]
Description=Rookhold execution gateway
Documentation=https://github.com/sambai-dev/rookhold/tree/main/docs
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/opt/rookhold/rootfs
ConditionFileIsExecutable=/usr/local/bin/rookhold-sandbox-init
ConditionFileIsExecutable=/usr/local/bin/runsc
ConditionPathExists=/etc/rookhold/attestation-key.pem
ConditionArchitecture=x86-64

[Service]
Type=simple
# Per-job gVisor and the namespace fallback need privileged runtime, mount,
# uid/gid, and cgroup operations. Keep this service on a dedicated x86_64 VM.
User=root
Group=root
EnvironmentFile=/etc/rookhold/rookhold.env
ExecStart=/usr/local/bin/rookhold
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=mixed
Delegate=yes
UMask=0077
StateDirectory=rookhold
StateDirectoryMode=0700
MemoryHigh=6G
MemoryMax=8G

NoNewPrivileges=yes
PrivateTmp=yes
# The helper creates a minimal private /dev for every job and therefore needs
# CAP_MKNOD. Do not enable systemd PrivateDevices without re-running the full
# hostile suite; systemd may remove that capability.
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=no
RestrictNamespaces=user mnt pid net ipc uts
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_SYS_CHROOT CAP_MKNOD CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL
ReadWritePaths=/var/lib/rookhold /sys/fs/cgroup
ReadOnlyPaths=/opt/rookhold/rootfs /usr/local/bin/rookhold /usr/local/bin/rookhold-sandbox-init /usr/local/bin/runsc /etc/rookhold/attestation-key.pem

[Install]
WantedBy=multi-user.target
