# Install as /etc/rookhold/rookhold.env with mode 0600. Fill ROOKHOLD_API_KEYS before start.
ROOKHOLD_ENV=production
ROOKHOLD_ADDR=127.0.0.1:7300
ROOKHOLD_API_KEYS=
# Optional: set a distinct high-entropy token to enable global /metrics.
ROOKHOLD_METRICS_TOKEN=
ROOKHOLD_SANDBOX=gvisor
ROOKHOLD_ROOTFS=/opt/rookhold/rootfs
ROOKHOLD_SANDBOX_HELPER=/usr/local/bin/rookhold-sandbox-init
ROOKHOLD_GVISOR_RUNSC=/usr/local/bin/runsc
ROOKHOLD_GVISOR_ROOTFS_SHA256=
ROOKHOLD_GVISOR_PLATFORM=systrap
ROOKHOLD_ATTESTATION_MODE=sign
ROOKHOLD_ATTESTATION_KEY_FILE=/etc/rookhold/attestation-key.pem
ROOKHOLD_JOBS_ROOT=/var/lib/rookhold/jobs
ROOKHOLD_DB=/var/lib/rookhold/rookhold.db
ROOKHOLD_SECCOMP=auto
ROOKHOLD_WORKERS=4
ROOKHOLD_TENANT_CONCURRENCY=2
ROOKHOLD_TENANT_QUEUE_CAPACITY=64
ROOKHOLD_RATE_PER_MIN=120
ROOKHOLD_MAX_JOB_MEM_MB=1024
ROOKHOLD_MEMORY_BUDGET_MB=4096
ROOKHOLD_STORAGE_TENANT_MB=4096
ROOKHOLD_STORAGE_GLOBAL_MB=16384
ROOKHOLD_STORAGE_FREE_RESERVE_MB=1024
ROOKHOLD_RETENTION_HOURS=168
ROOKHOLD_SWEEP_INTERVAL_SECS=3600
ROOKHOLD_LOG_FORMAT=json
RUST_LOG=info,coop_server=info
