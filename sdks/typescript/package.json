{
  "name": "rookhold",
  "version": "0.8.0",
  "description": "Typed browser and Node.js client for the Rookhold execution gateway",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/rookhold.js",
  "types": "./dist/rookhold.d.ts",
  "exports": {
    ".": {
      "types": "./dist/rookhold.d.ts",
      "import": "./dist/rookhold.js",
      "default": "./dist/rookhold.js"
    },
    "./coop": {
      "types": "./dist/coop.d.ts",
      "import": "./dist/coop.js",
      "default": "./dist/coop.js"
    }
  },
  "files": [
    "dist",
    "rookhold.ts",
    "coop.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "pack-smoke": "node tests/package-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.typecheck.json",
    "test": "npm run build && node tests/coop.test.mjs && npm run pack-smoke"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agents",
    "sandbox",
    "code-execution",
    "audit"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sambai-dev/rookhold.git",
    "directory": "sdks/typescript"
  },
  "bugs": "https://github.com/sambai-dev/rookhold/issues",
  "homepage": "https://sambai-dev.github.io/rookhold/",
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
