{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sambai-dev/coop/blob/main/crates/coop-attestation/schema/coop-execution-statement-v1.schema.json",
  "$comment": "Runtime verification additionally requires JSON integer tokens to deserialize exactly as Rust u32/u64 values, cross-field equality, receipt canonical-hash validity, signature policy, and actual subject bytes.",
  "title": "Coop execution attestation Statement v1",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/resourceDescriptor"
      }
    },
    "predicateType": {
      "const": "https://github.com/sambai-dev/coop/blob/main/crates/coop-attestation/FORMAT.md#predicate-v1"
    },
    "predicate": {
      "$ref": "#/$defs/predicate"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resourceDescriptor": {
      "type": "object",
      "required": ["name", "digest", "mediaType"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "digest": {
          "type": "object",
          "required": ["sha256"],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[!-.0-~]+/[!-.0-~]+$"
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["name", "mediaType", "sizeBytes", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[!-.0-~]+/[!-.0-~]+$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "predicate": {
      "type": "object",
      "required": ["schemaVersion", "executionId", "tenant", "result", "receipt"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "executionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": ["version", "job_id", "outcome", "receipt_sha256", "event_chain"],
      "properties": {
        "version": {
          "const": 1
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "outcome": {
          "enum": ["succeeded", "failed", "timed_out", "oom_killed", "cancelled", "error"]
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "event_chain": {
          "type": "object",
          "required": ["version", "head", "events", "complete"],
          "properties": {
            "version": {
              "const": 1
            },
            "head": {
              "$ref": "#/$defs/sha256"
            },
            "events": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "complete": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
